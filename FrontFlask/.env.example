# ══════════════════════════════════════════════
# .env.example - Plantilla de variables de entorno para FrontFlask
#
# COMO USAR:
#   1. Copie este archivo a .env (en la misma carpeta FrontFlask/).
#   2. Rellene los valores reales.
#   3. NUNCA suba .env al repo (esta gitignored).
#
# En produccion (Render) NO se necesita este archivo: las env vars se
# configuran en el panel "Environment" del servicio.
# ══════════════════════════════════════════════

# Clave secreta para firmar cookies de sesion Flask.
# Debe ser una cadena larga y aleatoria. Cambie este valor.
SECRET_KEY=cambia-este-valor-por-una-cadena-larga-y-aleatoria

# URL base de la API REST que consume el frontend.
API_BASE_URL=http://link-de-tu-API:puerto
